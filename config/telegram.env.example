# Raw key=value format: no quotes or variable interpolation.
# Configure through scripts/setup-telegram.sh; never commit a real secret file.
HERMES_TELEGRAM_CLIENT_ID=
HERMES_TELEGRAM_CLIENT_SECRET=
HERMES_TELEGRAM_OWNER_USERNAME=
HERMES_TELEGRAM_ALLOWED_ID=
# Optional invited account IDs, separated by commas. Owner access stays separate.
HERMES_TELEGRAM_ALLOWED_IDS=
# Application session lifetime, independent of the short Telegram token (1–90 days).
HERMES_TELEGRAM_SESSION_DAYS=30
