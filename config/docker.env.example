# Copy to /etc/agent-council/compose.env on the server. No secrets here.
COUNCIL_HERMES_IMAGE=agent-council-hermes:local
HERMES_DATA_DIR=/var/lib/agent-council/hermes
HERMES_WORKSPACE_DIR=/var/lib/agent-council/workspace
HERMES_AUTH_ENV_FILE=/etc/hermes/telegram.env
HERMES_HTTP_PORT=9119
HERMES_PUBLIC_URL=https://council.zavarov.com
HERMES_UID=10000
HERMES_GID=10000
