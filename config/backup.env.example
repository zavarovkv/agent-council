# Store as /etc/agent-council/backup.env with mode 0600; do not source this file.
# Generate a token limited to Object Read & Write for this bucket only.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/agent-council-backups/production
AWS_ACCESS_KEY_ID=replace-interactively
AWS_SECRET_ACCESS_KEY=replace-interactively
AWS_DEFAULT_REGION=auto
